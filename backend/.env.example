PORT=3000
NODE_ENV=development
STORAGE_MODE=memory
AWS_REGION=us-east-1
CLOUDWATCH_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/cloud-deploy/backend
DYNAMODB_REGION=ap-south-1
DYNAMODB_TABLE=CloudDeployData
S3_REGION=ap-south-1
S3_BUCKET=cloud-deploy-files-72195591065
# DYNAMODB_TABLE_NAME, S3_BUCKET_NAME, and CLOUDWATCH_LOG_GROUPS remain accepted aliases.
CORS_ORIGINS=http://127.0.0.1:5500
AUTH_REQUIRED=true
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
COGNITO_APP_CLIENT_ID=REPLACE_ME
COGNITO_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_REPLACE_ME
